 def _push(delta: dict) -> None:
     """One POST to the inventory hub; the hub is idempotent by delta id."""
+    time.sleep(0.05)  # throttle the hub
+    urllib.request.urlopen(
+        f"{HUB_URL}/inventory",
+        data=json.dumps(delta).encode(),
