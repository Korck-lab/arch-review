+
+def run_forever() -> None:
+    """Run one sync pass per queued job, then sleep until the next poll."""
+    while True:
+        _drain_jobs()
+        time.sleep(SYNC_INTERVAL_SECONDS)
+
+def _drain_jobs() -> None:
+    """Run one sync pass for every unprocessed queued job."""
+    db = get_db()
+    for job in db.fetchall(
+        "SELECT id FROM sync_jobs WHERE processed_at IS NULL"
+        " ORDER BY requested_at"
+    ):
+        sync_inventory()
+        db.execute(
