@@ -0,0 +1,27 @@
+# billing/retry.py
+"""Retry policy for charge_card calls."""
+
+import time
+from collections.abc import Callable
+from typing import TypeVar
+
+from billing.gateway import GatewayError
+
+T = TypeVar("T")
+
+
+def with_retry(
+    fn: Callable[[str], T],
+    *,
+    attempts: int = 3,
+    idempotency_key: str,
+    base_delay: float = 0.1,
+) -> T:
+    """Call fn with the key, retrying on transient gateway errors."""
+    for attempt in range(attempts):
+        try:
+            return fn(idempotency_key)
+        except GatewayError:
+            if attempt == attempts - 1:
+                raise
+            time.sleep(base_delay * (2 ** attempt))
