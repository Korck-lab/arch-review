@@ -0,0 +1,15 @@
+# api/webhooks.py
+"""Webhook registration for the public API."""
+
+from api import db, secrets
+
+def register_webhook(customer_id: str, url: str, events: list[str]) -> dict:
+    """Register a webhook that receives a customer's events."""
+    row = db.insert(
+        "INSERT INTO webhooks (customer_id, url, events, secret) VALUES (%s, %s, %s, %s)",
+        customer_id,
+        url,
+        ",".join(events),
+        secrets.new_secret(),
+    )
+    return {"webhook_id": row["id"], "secret": row["secret"]}
