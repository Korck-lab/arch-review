+# shop/catalog.py
+"""Product lookups for the shop API."""
+
+from functools import lru_cache
+
+from shop import db
+
+@lru_cache(maxsize=512)
+def _cached_title(product_id: str) -> str:
+    """Title of an existing product; missing ids are not cached."""
+    row = db.fetchone("SELECT title FROM products WHERE id = %s", product_id)
+    if row is None:
+        raise KeyError(product_id)
+    return row["title"]
+
+def product_title(product_id: str) -> str:
+    """Title of a product; 'Unknown product' for a missing id."""
+    try:
+        return _cached_title(product_id)
+    except KeyError:
+        return "Unknown product"
